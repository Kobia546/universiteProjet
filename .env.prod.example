# Copier ce fichier vers .env.prod et remplir les vraies valeurs.
# NE JAMAIS committer .env.prod dans un dépôt Git.

POSTGRES_USER=erp_prod
POSTGRES_PASSWORD=change-me-generate-a-real-random-password
POSTGRES_DB=erp_universite

# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-generate-a-long-random-secret
JWT_EXPIRES_IN=8h

# URL publique du frontend (pour la config CORS du backend) — SANS slash final,
# sinon la comparaison CORS échoue (l'origine envoyée par le navigateur n'en a jamais).
FRONTEND_URL=https://votre-domaine.com

# URL publique de l'API, utilisée par le frontend au moment du build.
# Avec Nginx en façade (voir deploy/nginx.conf.example) qui proxifie /api/ vers
# le backend sur le même domaine, pas besoin de sous-domaine ni de port ":3000".
VITE_API_URL=https://votre-domaine.com/api/v1
