// Schéma Prisma — ERP Universitaire (mono-établissement)
// Cible : PostgreSQL.
//
// Terminologie :
// - Niveau   = le niveau d'études (L1, L2, L3, M1, M2).
// - Filiere  = la spécialité choisie à l'inscription (Droit de l'Homme,
//              Droit des Affaires, Droit des Contentieux, Fiscalité des
//              Entreprises, Droit de l'Environnement...).
//              Une inscription = un niveau + une filière, affichés
//              ensemble partout : « Licence 1 – Droit des Affaires ».
// - Matiere  = un simple catalogue informatif de cours, rattaché aux
//              niveaux. Les étudiants ne choisissent pas de matières.
// - Les frais de scolarité (ReglePaiement) dépendent du niveau et du type
//   d'étudiant, pas de la filière.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------
// Utilisateurs & rôles
// ------------------------------------------------------------------
enum ModuleCode {
  TABLEAU_DE_BORD
  ADMINISTRATION
  INSCRIPTIONS
  ETUDIANTS
  PAIEMENTS
  COMPTABILITE
  CONSULTATIONS
  EDITIONS
  AIDE
}

model Profil {
  id          String       @id @default(uuid())
  nom         String       @unique
  description String?
  modules     ModuleCode[]
  // Profil créé par le seed (ex: Administrateur) — protégé contre la suppression.
  systeme     Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  users       User[]

  @@map("profils")
}

model User {
  id             String   @id @default(uuid())
  nom            String
  prenom         String
  email          String   @unique
  motDePasseHash String
  actif          Boolean  @default(true)
  createdAt      DateTime @default(now())

  profilId String
  profil   Profil @relation(fields: [profilId], references: [id])

  inscriptions Inscription[]     @relation("AgentInscription")
  paiements    Paiement[]        @relation("AgentPaiement")
  recettes     EcritureRecette[] @relation("AgentRecette")
  depenses     EcritureDepense[] @relation("AgentDepense")
  auditLogs    AuditLog[]

  @@map("users")
}

model AuditLog {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  action        String
  ressourceType String
  ressourceId   String
  detailsJson   Json?
  createdAt     DateTime @default(now())

  @@index([ressourceType, ressourceId])
  @@map("audit_log")
}

// ------------------------------------------------------------------
// Étudiants
// ------------------------------------------------------------------
enum Sexe {
  M
  F
}

enum TypeEtudiant {
  ETUDIANT
  TRAVAILLEUR
}

model Etudiant {
  id                          String       @id @default(uuid())
  matricule                   String       @unique
  nom                         String
  prenom                      String
  // Optionnels : certains imports en masse (historique papier) n'ont pas
  // cette information au moment de la saisie — à compléter plus tard.
  sexe                        Sexe?
  type                        TypeEtudiant @default(ETUDIANT)
  dateNaissance               DateTime?
  lieuNaissance               String?
  telephone                   String?
  email                       String?
  adresse                     String?
  photoUrl                    String?
  informationsComplementaires String?
  createdAt                   DateTime     @default(now())
  updatedAt                   DateTime     @updatedAt

  inscriptions Inscription[]
  paiements    Paiement[]

  @@map("etudiants")
}

// ------------------------------------------------------------------
// Niveaux (L1-M2), Filières (spécialités) & Matières (catalogue informatif)
// ------------------------------------------------------------------
model Niveau {
  id      String @id @default(uuid())
  code    String @unique // L1, L2, L3, M1, M2
  libelle String // Licence 1, Licence 2...

  matieres       NiveauMatiere[]
  anneesOuvertes NiveauAnnee[]
  inscriptions   Inscription[]
  reglesPaiement ReglePaiement[]

  @@map("niveaux")
}

// Spécialité choisie à l'inscription, après le niveau.
model Filiere {
  id      String  @id @default(uuid())
  code    String  @unique // DH, DA, DC, FE, DE
  libelle String // Droit des Affaires...
  // Une filière désactivée n'est plus proposée aux nouvelles inscriptions
  // mais reste visible sur les inscriptions déjà enregistrées.
  actif   Boolean @default(true)

  inscriptions Inscription[]

  @@map("filieres")
}

model Matiere {
  id    String  @id @default(uuid())
  nom   String
  code  String  @unique
  actif Boolean @default(true)

  niveaux NiveauMatiere[]

  @@map("matieres")
}

// Catalogue : quelles matières sont enseignées dans quel niveau.
// Non spécifique à une année — purement informatif.
model NiveauMatiere {
  id        String  @id @default(uuid())
  niveauId  String
  niveau    Niveau  @relation(fields: [niveauId], references: [id])
  matiereId String
  matiere   Matiere @relation(fields: [matiereId], references: [id])

  @@unique([niveauId, matiereId])
  @@map("niveau_matieres")
}

model AnneeUniversitaire {
  id        String   @id @default(uuid())
  libelle   String
  dateDebut DateTime
  dateFin   DateTime
  active    Boolean  @default(false)

  niveauxOuverts NiveauAnnee[]
  inscriptions   Inscription[]
  reglesPaiement ReglePaiement[]

  @@map("annees_universitaires")
}

// Ouverture d'un niveau pour une année universitaire donnée.
model NiveauAnnee {
  id                   String             @id @default(uuid())
  niveauId             String
  niveau               Niveau             @relation(fields: [niveauId], references: [id])
  anneeUniversitaireId String
  anneeUniversitaire   AnneeUniversitaire @relation(fields: [anneeUniversitaireId], references: [id])
  actif                Boolean            @default(true)

  @@unique([niveauId, anneeUniversitaireId])
  @@map("niveau_annees")
}

// ------------------------------------------------------------------
// Inscriptions
// ------------------------------------------------------------------
enum StatutInscription {
  EN_COURS
  VALIDEE
  ANNULEE
  TRANSFEREE
}

model Inscription {
  id                   String             @id @default(uuid())
  numeroInscription    String             @unique
  etudiantId           String
  etudiant             Etudiant           @relation(fields: [etudiantId], references: [id])
  niveauId             String
  niveau               Niveau             @relation(fields: [niveauId], references: [id])
  // Obligatoire pour toute nouvelle inscription (contrôlé par l'API) ;
  // nullable uniquement pour les inscriptions historiques sans spécialité
  // connue — l'affichage retombe alors sur le niveau seul.
  filiereId            String?
  filiere              Filiere?           @relation(fields: [filiereId], references: [id])
  anneeUniversitaireId String
  anneeUniversitaire   AnneeUniversitaire @relation(fields: [anneeUniversitaireId], references: [id])
  statut               StatutInscription  @default(EN_COURS)
  dateInscription      DateTime           @default(now())
  montantTotalDu       Decimal            @db.Decimal(12, 2)

  agentId String
  agent   User   @relation("AgentInscription", fields: [agentId], references: [id])

  echeances Echeance[]
  paiements Paiement[]

  createdAt DateTime @default(now())

  @@index([niveauId])
  @@index([filiereId])
  @@map("inscriptions")
}

// ------------------------------------------------------------------
// Règles de paiement configurables (par niveau et/ou type d'étudiant)
// ------------------------------------------------------------------
model ReglePaiement {
  id                     String             @id @default(uuid())
  niveauId               String?
  niveau                 Niveau?            @relation(fields: [niveauId], references: [id])
  type                   TypeEtudiant? // null = s'applique aux deux types
  anneeUniversitaireId   String
  anneeUniversitaire     AnneeUniversitaire @relation(fields: [anneeUniversitaireId], references: [id])
  montantTotal           Decimal            @db.Decimal(12, 2)
  pourcentageInscription Int
  nombreEcheances        Int
  createdAt              DateTime           @default(now())

  @@map("regles_paiement")
}

enum StatutEcheance {
  A_PAYER
  PARTIEL
  SOLDE
  EN_RETARD
}

model Echeance {
  id             String         @id @default(uuid())
  inscriptionId  String
  inscription    Inscription    @relation(fields: [inscriptionId], references: [id])
  numeroEcheance Int
  montantPrevu   Decimal        @db.Decimal(12, 2)
  dateLimite     DateTime
  statut         StatutEcheance @default(A_PAYER)

  @@map("echeances")
}

// ------------------------------------------------------------------
// Paiements & reçus
// ------------------------------------------------------------------
enum ModePaiement {
  ESPECES
  CHEQUE
}

enum StatutPaiement {
  VALIDE
  ANNULE
}

model Paiement {
  id              String         @id @default(uuid())
  referenceUnique String         @unique
  inscriptionId   String
  inscription     Inscription    @relation(fields: [inscriptionId], references: [id])
  etudiantId      String
  etudiant        Etudiant       @relation(fields: [etudiantId], references: [id])
  montant         Decimal        @db.Decimal(12, 2)
  motif           String
  modePaiement    ModePaiement
  // Renseignés uniquement si modePaiement = CHEQUE
  numeroCheque    String?
  banque          String?
  datePaiement    DateTime       @default(now())
  statut          StatutPaiement @default(VALIDE)

  agentId String
  agent   User   @relation("AgentPaiement", fields: [agentId], references: [id])

  recu    Recu?
  recette EcritureRecette?

  createdAt DateTime @default(now())

  @@map("paiements")
}

model Recu {
  id             String      @id @default(uuid())
  // Numéro auto-généré par l'app, purement séquentiel et toujours unique —
  // affiché en premier sur le reçu, indépendant du carnet papier.
  numeroSequence Int         @unique @default(autoincrement())
  // Le numéro du reçu physique tel que saisi par le comptable (celui du
  // carnet papier) — affiché en dessous du numéro app sur le reçu imprimé.
  numeroRecu     String      @unique
  paiementId     String      @unique
  paiement       Paiement    @relation(fields: [paiementId], references: [id])
  carnetRecuId   String?
  carnetRecu     CarnetRecu? @relation(fields: [carnetRecuId], references: [id])
  pdfUrl         String?
  dateEmission   DateTime    @default(now())

  @@map("recus")
}

// Configuration des carnets de reçus physiques par plage de numéros (ex :
// 90 à 95) — le comptable remplit d'abord le carnet papier, puis saisit le
// numéro exact du reçu physique au moment du paiement dans l'app. Cette
// plage sert à vérifier que le numéro saisi appartient bien à un carnet
// réellement distribué (évite les fautes de frappe / numéros inventés).
model CarnetRecu {
  id          String   @id @default(uuid())
  numeroDebut Int
  numeroFin   Int
  actif       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  recus      Recu[]
  exclusions NumeroCarnetExclu[]

  @@map("carnets_recu")
}

// Numéro d'un carnet papier qui n'est plus utilisable : reçu arraché,
// déchiré, perdu ou annulé sur le carnet physique. Déclaré par
// l'administrateur ; l'API refuse ensuite ce numéro à l'enregistrement
// d'un paiement.
model NumeroCarnetExclu {
  id           String     @id @default(uuid())
  carnetRecuId String
  carnetRecu   CarnetRecu @relation(fields: [carnetRecuId], references: [id], onDelete: Cascade)
  numero       Int
  motif        String?
  createdAt    DateTime   @default(now())

  @@unique([carnetRecuId, numero])
  @@map("numeros_carnet_exclus")
}

// ------------------------------------------------------------------
// Comptabilité : EP703 (recettes) / EP704 (dépenses)
// ------------------------------------------------------------------
enum StatutEcriture {
  VALIDE
  CONTRE_PASSE
}

model EcritureRecette {
  id                    String         @id @default(uuid())
  numeroBordereau       String         @unique
  date                  DateTime       @default(now())
  libelle               String
  // Qui a demandé/remis l'opération — champ du "Bon de caisse" papier.
  requerant             String?
  compteDebit           String         @default("565")
  compteCredit          String         @default("445")
  montant               Decimal        @db.Decimal(12, 2)
  paiementId            String?        @unique
  paiement              Paiement?      @relation(fields: [paiementId], references: [id])
  pieceJustificativeUrl String?
  statut                StatutEcriture @default(VALIDE)

  agentId String
  agent   User   @relation("AgentRecette", fields: [agentId], references: [id])

  createdAt DateTime @default(now())

  @@map("ep703_recettes")
}

model EcritureDepense {
  id              String         @id @default(uuid())
  numeroOperation String         @unique
  date            DateTime       @default(now())
  libelle         String
  // Qui a demandé/remis l'opération — champ du "Bon de caisse" papier.
  requerant       String?
  compteDebit     String         @default("445")
  compteCredit    String         @default("565")
  montant         Decimal        @db.Decimal(12, 2)
  justificatifUrl String?
  statut          StatutEcriture @default(VALIDE)

  agentId String
  agent   User   @relation("AgentDepense", fields: [agentId], references: [id])

  createdAt DateTime @default(now())

  @@map("ep704_depenses")
}
