DATABASE_URL="postgresql://postgres:postgres@localhost:5432/erp_universite?schema=public"
# En production, génère un secret long et aléatoire, par exemple :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# L'appli refuse de démarrer si ce secret fait moins de 16 caractères.
JWT_SECRET="change-me-in-production-use-a-long-random-string"
JWT_EXPIRES_IN="8h"
PORT=3000
FRONTEND_URL="http://localhost:5173"
